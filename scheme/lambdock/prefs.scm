;; =============================================================================
;; Preferences written by the GUI
;; =============================================================================
;;
;; The settings file is the source of truth for the dock, but it is usually
;; generated by some other tool (an operating-system image, a dotfiles
;; generator, a Scheme module) that would overwrite a hand edit on its next run.
;; The GTK preferences window therefore writes what the user changes in *this*
;; file and never touches settings.scm:
;;
;;   ${XDG_STATE_HOME:-~/.local/state}/lambdock/preferences-<settings-stem>.scm
;;
;; It records a single alist of the settings the user changed through the GUI,
;; and is layered on top of the settings file when it is loaded, so a
;; regenerated settings file keeps the GUI choices while everything the user
;; never touched comes back from the generator. Deleting the file restores the
;; settings file exactly.
;;
;; The same file also survives restarts, so `set-dock-preference!' does two
;; things on every GUI edit: it updates the running dock through the ordinary
;; `set-dock-*!' setter, and it remembers the value here.
;; =============================================================================

(define-module (lambdock prefs)
  #:declarative? #f
  #:use-module (ice-9 format)
  #:use-module (srfi srfi-1)
  #:use-module (lambdock logger)
  #:use-module (lambdock state)
  #:export (dock-preferences-path
            dock-preferences-read
            apply-dock-preferences
            save-dock-preference!
            set-dock-preference!
            reset-dock-preferences!))

;; =============================================================================
;; State directory & file location
;; =============================================================================

;; Mirrors `(lambdock layout)': runtime state that must not be confused with the
;; user's configuration lives under XDG_STATE_HOME.
(define (dock-state-dir)
  (let ((xdg (getenv "XDG_STATE_HOME"))
        (home (getenv "HOME")))
    (cond ((and xdg (not (string-null? xdg)))
           (string-append xdg "/lambdock"))
          (home (string-append home "/.local/state/lambdock"))
          (else "/tmp/lambdock"))))

(define (dock-preferences-path config-path)
  "Path of the GUI preference overrides belonging to CONFIG-PATH.

Each settings file gets its own override file, named after it, so several docks
never share their GUI choices."
  (let* ((raw (cond ((string? config-path) config-path)
                    ((symbol? config-path) (symbol->string config-path))
                    (else "settings.scm")))
         (base (basename raw))
         (stem (if (string-suffix? ".scm" base)
                   (substring base 0 (- (string-length base) 4))
                   base)))
    (string-append (dock-state-dir) "/preferences-" stem ".scm")))

;; Create the state directory (recursively) the first time a preference is
;; written.
(define (ensure-directory dir)
  (unless (or (string-null? dir) (file-exists? dir))
    (ensure-directory (dirname dir))
    (catch 'system-error (lambda () (mkdir dir)) (lambda _ #t))))

;; =============================================================================
;; Reading & writing the override file
;; =============================================================================

(define (preference-pair? value)
  (and (pair? value) (symbol? (car value))))

(define (dock-preferences-read config-path)
  "Reads the GUI preference overrides for CONFIG-PATH as an alist of
\(setting . value) pairs. A missing, unreadable or malformed file simply means
\"no overrides\"."
  (let* ((path (dock-preferences-path config-path))
         (data (catch #t
                 (lambda ()
                   (and (file-exists? path) (call-with-input-file path read)))
                 (lambda (key . args)
                   (log-warn "Preferences"
                             "Ignoring unreadable preferences ~a (~a)"
                             path key)
                   #f))))
    (if (and (list? data) (every preference-pair? data))
        data
        '())))

(define (apply-dock-preferences settings config-path)
  "Returns SETTINGS with the GUI overrides stored for CONFIG-PATH layered on top.

The overrides are prepended, so the loader's `assq' lookups find them before the
values the settings file defined. This is what makes a regenerated settings file
keep the user's GUI choices.

Logged on every load: \"which preferences were in effect at startup\" was
otherwise only answerable by opening the Preferences window."
  (let ((overrides (dock-preferences-read config-path)))
    (if (null? overrides)
        settings
        (begin
          (log-info "Preferences"
                    "Applied ~a GUI preference(s) for ~a: ~{~a~^, ~}"
                    (length overrides) config-path (map car overrides))
          (append overrides settings)))))

(define (save-dock-preference! config-path key value)
  "Remembers KEY => VALUE for CONFIG-PATH in the GUI preference override file.

Only real settings-file paths are persisted: the fallback dock, which has no
settings file, can have GUI edits for the session but nowhere to keep them."
  (when (and (string? config-path)
             (not (string-null? config-path))
             (symbol? key))
    (let* ((path (dock-preferences-path config-path))
           (existing (dock-preferences-read config-path))
           (updated (cons (cons key value)
                          (filter (lambda (pair)
                                    (not (eq? (car pair) key)))
                                  existing))))
      (catch #t
             (lambda ()
               (ensure-directory (dirname path))
               (call-with-output-file path
                 (lambda (port)
                   (format port ";; lambdock preferences for ~a~%" config-path)
                   (format port
                           ";; Written by the Preferences window. Delete this file to reset.~%")
                   (write updated port)
                   (newline port)))
               (log-info "Preferences" "Saved ~a => ~s for ~a" key value
                         config-path)
               #t)
             (lambda (err . args)
               (log-error "Preferences"
                          "Could not write preferences ~a (~a ~s)"
                          path err args)
               #f)))))

(define (reset-dock-preferences! config-path)
  "Forgets every GUI override of CONFIG-PATH."
  (let ((path (dock-preferences-path config-path)))
    (catch #t
           (lambda ()
             (when (file-exists? path)
               (delete-file path))
             (log-info "Preferences" "Cleared GUI preferences for ~a"
                       config-path)
             #t)
           (lambda (err . args)
             (log-error "Preferences" "Could not clear preferences ~a (~a ~s)"
                        path err args)
             #f))))

;; =============================================================================
;; Applying a single GUI edit
;; =============================================================================

;; Which setting can be changed from the GUI, and which setter applies it. The
;; keys are the settings-file names, so a stored override reads back exactly the
;; way the settings file would have written it.
(define %preference-setters
  '((dock-auto-hide? . set-dock-auto-hide!)
    (dock-show-when-clear? . set-dock-show-when-clear!)
    (dock-hover-animate? . set-dock-hover-animate!)
    (dock-track-windows? . set-dock-track-windows!)
    (dock-show-window-titles? . set-dock-show-window-titles!)
    (dock-position . set-dock-position!)
    (dock-theme . set-dock-theme!)
    (dock-mode . set-dock-mode!)
    (dock-icon-size . set-dock-icon-size!)
    (dock-item-spacing . set-dock-item-spacing!)
    (dock-capsule-padding . set-dock-capsule-padding!)
    (dock-shelf-tilt . set-dock-shelf-tilt!)
    (dock-shelf-perspective . set-dock-shelf-perspective!)
    (dock-shelf-margin . set-dock-shelf-margin!)
    (dock-shelf-front . set-dock-shelf-front!)
    (dock-reflection . set-dock-reflection!)
    (dock-reflection-intensity . set-dock-reflection-intensity!)
    (dock-reflection-blur . set-dock-reflection-blur!)
    (dock-shelf-flare . set-dock-shelf-flare!)
    (dock-launchpad-icon-size . set-dock-launchpad-icon-size!)
    (dock-launchpad-columns . set-dock-launchpad-columns!)
    (dock-launchpad-blur? . set-dock-launchpad-blur!)
    (dock-launchpad-close-side . set-dock-launchpad-close-side!)
    (dock-reduce-motion? . set-dock-reduce-motion!)))

(define (set-dock-preference! key value config-path)
  "Applies one GUI edit: updates the running dock and remembers it.

KEY is a settings-file name (a symbol such as `dock-icon-size'), VALUE is the
new setting, and CONFIG-PATH selects the dock. The ordinary setter both mutates
the in-memory configuration and triggers `(reload-dock!)', so the change is
visible immediately; persisting it afterwards is what makes it survive a
restart."
  (let ((setter-name (assq-ref %preference-setters key)))
    (when setter-name
      (let ((setter (module-ref (resolve-module '(lambdock state))
                                setter-name
                                #f)))
        (if (procedure? setter)
            (begin
              (setter value config-path)
              (save-dock-preference! config-path key value))
            (log-warn "Preferences" "Unknown preference setter ~a" setter-name))))))
