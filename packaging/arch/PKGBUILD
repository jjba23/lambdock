pkgname=lambdock
pkgver=0.6.7
pkgrel=1
pkgdesc="Wayland-native GTK4 dock customizable in Guile Scheme"
arch=('x86_64' 'aarch64')
url="https://codeberg.org/jjba23/lambdock"
license=('GPL-3.0-or-later')

# Runtime dependencies (matched from spec file pkgconfig links)
depends=(
  'glib2'
  'gtk4'
  'gtk4-layer-shell'
  'guile'
  'wayland'
)

# Build-time dependencies
makedepends=(
  'meson'
  'ninja'
  'pkgconf'
  'wayland-protocols'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP') # Replace with actual SHA256 checksum for tagged releases

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install -C build

  # Arch Policy: Install license to /usr/share/licenses/$pkgname/
  install -Dm644 "$srcdir/$pkgname-$pkgver/COPYING" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
