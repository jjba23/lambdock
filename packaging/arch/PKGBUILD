# lambdock -- hyper-hackable desktop dock for Wayland
#
# SPDX-License-Identifier: MIT
# Copyright © Josep Bigorra <jjbigorra@gmail.com>

# Maintainer: Josep Bigorra <jjbigorra@gmail.com>
pkgname=lambdock
pkgver=2.3.3
pkgrel=1
pkgdesc="GTK4 desktop dock customizable in Guile Scheme"
arch=('x86_64' 'aarch64')
url="https://github.com/jjba23/lambdock"
license=('MIT')

depends=(
  'glib2'
  'gtk4'
  'gtk4-layer-shell'
  'guile'
  'libx11'
  'wayland'
)

makedepends=(
  'cargo'
  'gettext'
  # `wayland` (in depends, above) is what ships `wayland-scanner`: there is no
  # package of that name, and build.rs runs the binary `wayland` provides.
  'glib2'
  'pkgconf'
  'rust'
  'wayland-protocols'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('ba88b892b4792a9a014b1889079e7c712aeb72755600c07bc9854d029f9aae04')

build() {
  cd "$srcdir/${pkgname}-${pkgver}"

  cargo build --offline --locked --release
}

check() {
  cd "$srcdir/${pkgname}-${pkgver}"

  cargo test --offline --locked
}

package() {
  cd "$srcdir/${pkgname}-${pkgver}"

  cargo run --offline --locked -p xtask -- install --prefix /usr --destdir "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
